# Copy to .env.local and fill in. .env.local is gitignored; never commit real
# values. A key is public the moment it is pushed and has to be rotated.

# ---- Supabase ----
# Whether a Supabase project exists for Redline is still an open decision, so
# these are deliberately blank. Do not create tables or run migrations against
# an existing project without confirming it is safe. The schema is in
# supabase/migrations/. With the two NEXT_PUBLIC_ values blank, accounts are
# off: /sign-in says so and /read still works without saving anything.

# The publishable/secret key pair, not the older anon/service_role JWTs —
# Supabase is retiring those at the end of 2026.

# Sent to the browser. Protected by row-level security, not by being secret.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server only. Bypasses row-level security entirely, so it never reaches the
# browser. The URL is repeated here so server code never depends on a value that
# is inlined into the client bundle at build time.
SUPABASE_URL=
SUPABASE_SECRET_KEY=

# ---- OpenRouter ----
# Which model to call has not been chosen. There is no default in the code, so
# leaving OPENROUTER_MODEL blank makes analysis fail rather than pick one.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=

# Optional, for attribution on the OpenRouter dashboard.
OPENROUTER_SITE_URL=
OPENROUTER_APP_NAME=
