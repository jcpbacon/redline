{
  "name": "redline",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "check:node": "node scripts/check-node.js",
    "check:audit": "node scripts/audit.js",
    "prebuild": "npm run check:node && npm run check:audit",
    "test": "vitest run --maxWorkers=2",
    "typecheck": "tsc --noEmit -p jsconfig.json",
    "smoke": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/smoke.mjs",
    "eval": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/eval.mjs"
  },
  "dependencies": {
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.117.2",
    "fflate": "^0.8.3",
    "next": "^16.3.8",
    "pdfjs-dist": "^6.3.289",
    "react": "^18.3.0",
    "react-dom": "^18.3.0"
  },
  "engines": {
    "node": "24.x"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@types/node": "^24.19.1",
    "pdf-lib": "^1.17.1",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3"
  }
}
